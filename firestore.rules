rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin';
    }

    // Kiểm tra user đang request có bị soft-delete không.
    // Dùng cho write operations để ngăn user bị xóa ghi dữ liệu mới.
    function callerIsNotDeleted() {
      let caller = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return caller.get('deleted', false) != true
          && caller.get('isDeleted', false) != true;
    }

    function isMemberOf(groupId) {
      return isAuth() && request.auth.uid in
        get(/databases/$(database)/documents/room_groups/$(groupId)).data.memberIds;
    }

    match /users/{userId} {
      // Admin đọc được tất cả (kể cả user bị deleted).
      // User thường chỉ đọc được nếu chính họ chưa bị deleted.
      allow read: if isAdmin()
        || (isAuth() && (
          // Đọc doc của người khác: được phép (cần cho profile discovery)
          // Đọc doc của chính mình: phải chưa bị deleted
          userId != request.auth.uid
          || resource.data.get('deleted', false) != true
        ));
      allow create: if isAuth() && isOwner(userId);
      // User không được tự thay đổi role, deleted, isDeleted
      allow update: if isAdmin()
        || (isAuth() && isOwner(userId)
            && callerIsNotDeleted()
            && !request.resource.data.diff(resource.data)
                   .affectedKeys().hasAny(['role', 'deleted', 'isDeleted', 'deletedAt']));
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------------
    // Mirrors the validation in PostViewModel.createPost / updatePost so that
    // a user with direct Firebase SDK access cannot bypass the app and write
    // an invalid or spoofed document.
    // ---------------------------------------------------------------------------

    function isValidPost() {
      let d = request.resource.data;
      return d.title is string
        && d.title.size() > 0
        && d.title.size() <= 200

        && d.location is string
        && d.location.size() > 0
        && d.location.size() <= 500

        && d.province is string
        && d.province.size() > 0
        && d.province.size() <= 100

        // district is optional but must be a string within length
        && d.district is string
        && d.district.size() <= 100

        // must be one of the values in RoomFilterData.roomTypes
        && d.roomType in [
             'Phòng trọ',
             'Phòng trong nhà nguyên căn',
             'Căn hộ / Chung cư',
             'Phòng master',
             'Phòng thường',
             'Phòng có gác',
             'Phòng không gác',
             'Phòng có nội thất',
             'Phòng không nội thất',
             'Studio (Phòng có nội thất)',
             'Duplex (Phòng có gác và nội thất)'
           ]

        && d.price is int && d.price > 0 && d.price <= 1000000000
        && d.area is int  && d.area  > 0 && d.area  <= 10000
        && d.capacity is int && d.capacity > 0 && d.capacity <= 100

        && d.description is string
        && d.description.size() > 0
        && d.description.size() <= 5000

        && d.imageUrl is string

        // at least one image URL, at most 5
        && d.imageUrls is list
        && d.imageUrls.size() > 0
        && d.imageUrls.size() <= 5

        && d.amenities is list && d.amenities.size() <= 20
        && d.lifestyleHabits is list && d.lifestyleHabits.size() <= 20;
    }

    match /posts/{postId} {
      allow read: if isAuth();

      allow create: if isAdmin()
        || (isAuth()
            && callerIsNotDeleted()
            && request.resource.data.ownerId == request.auth.uid
            && request.resource.data.keys().hasAll([
                 'title', 'location', 'province', 'district',
                 'roomType', 'amenities', 'lifestyleHabits',
                 'price', 'area', 'capacity', 'description',
                 'imageUrl', 'imageUrls', 'ownerId', 'createdAt', 'updatedAt'
               ])
            && isValidPost());

      allow update: if isAdmin()
        || (isAuth()
            && callerIsNotDeleted()
            && resource.data.ownerId == request.auth.uid
            && !request.resource.data.diff(resource.data)
                   .affectedKeys().hasAny(['ownerId', 'createdAt'])
            && isValidPost());

      allow delete: if isAdmin()
        || (isAuth() && callerIsNotDeleted() && resource.data.ownerId == request.auth.uid);
    }

    match /roommate_requests/{requestId} {
      allow read: if isAdmin()
        || (isAuth() && (
            resource.data.requesterId == request.auth.uid ||
            resource.data.postOwnerId == request.auth.uid
        ));
      allow create: if isAdmin()
        || (isAuth()
            && callerIsNotDeleted()
            && request.resource.data.requesterId == request.auth.uid
            && request.resource.data.status == 'pending');
      allow update: if isAdmin()
        || (isAuth() && callerIsNotDeleted() && resource.data.postOwnerId == request.auth.uid);
      allow delete: if isAdmin()
        || (isAuth() && callerIsNotDeleted() && (
            resource.data.requesterId == request.auth.uid ||
            resource.data.postOwnerId == request.auth.uid
        ));
    }

    match /room_groups/{groupId} {
      allow read: if isAdmin()
        || (isAuth() && request.auth.uid in resource.data.memberIds);
      allow create: if isAdmin()
        || (isAuth()
            && request.resource.data.ownerId == request.auth.uid
            && request.auth.uid in request.resource.data.memberIds);
      allow update: if isAdmin()
        || (isAuth() && resource.data.ownerId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow read: if isAdmin()
        || (isAuth() && resource.data.reporterId == request.auth.uid);
      allow create: if isAuth();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /expenses/{expenseId} {
      allow read: if isAdmin() || (isAuth() && isMemberOf(resource.data.roomGroupId));
      allow create: if isAuth() && isMemberOf(request.resource.data.roomGroupId);
      allow update: if isAuth() && isMemberOf(resource.data.roomGroupId);
      allow delete: if isAdmin() || (isAuth() && isMemberOf(resource.data.roomGroupId));
    }

    match /expense_shares/{shareId} {
      allow read: if isAdmin() || (isAuth() && isMemberOf(resource.data.roomGroupId));
      allow create: if isAuth() && isMemberOf(request.resource.data.roomGroupId);
      allow update: if isAdmin() || (isAuth() && (
        resource.data.fromUserId == request.auth.uid ||
        isMemberOf(resource.data.roomGroupId)
      ));
      allow delete: if isAdmin() || (isAuth() && isMemberOf(resource.data.roomGroupId));
    }

  }
}
