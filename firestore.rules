rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // ── users ────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isAuth() && isOwner(userId);
      allow update: if isAuth() && isOwner(userId);
      allow delete: if false;
    }

    // ── posts ─────────────────────────────────────────────────────────────────
    match /posts/{postId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuth() && resource.data.ownerId == request.auth.uid;
      allow delete: if isAuth() && resource.data.ownerId == request.auth.uid;
    }

    // ── roommate_requests ─────────────────────────────────────────────────────
    match /roommate_requests/{requestId} {
      allow read: if isAuth() && (
        resource.data.requesterId == request.auth.uid ||
        resource.data.postOwnerId == request.auth.uid
      );
      allow create: if isAuth();
      allow update: if isAuth() && resource.data.postOwnerId == request.auth.uid;
      allow delete: if false;
    }

    // ── room_groups ───────────────────────────────────────────────────────────
    match /room_groups/{groupId} {
      allow read: if isAuth() && request.auth.uid in resource.data.memberIds;
      allow create: if isAuth();
      allow update: if isAuth() && resource.data.ownerId == request.auth.uid;
      allow delete: if false;
    }

    // ── expenses ──────────────────────────────────────────────────────────────
    match /expenses/{expenseId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && request.auth.uid in
        get(/databases/$(database)/documents/room_groups/$(resource.data.roomGroupId)).data.memberIds;
      allow delete: if isAuth() && request.auth.uid in
        get(/databases/$(database)/documents/room_groups/$(resource.data.roomGroupId)).data.memberIds;
    }

    // ── expense_shares ────────────────────────────────────────────────────────
    // create : any authenticated user (batch write after addExpense)
    // update : the debtor (fromUserId) marks a share as paid
    // delete : the creditor (toUserId) OR the expense payer — needed so
    //          deleteExpense / updateExpense can remove all shares in one batch
    match /expense_shares/{shareId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && resource.data.fromUserId == request.auth.uid;
      allow delete: if isAuth() && request.auth.uid in
        get(/databases/$(database)/documents/room_groups/$(resource.data.roomGroupId)).data.memberIds;
    }

    // ── roommate_profile_invites ──────────────────────────────────────────────
    match /roommate_profile_invites/{inviteId} {
      allow read: if isAuth() && (
        resource.data.senderId     == request.auth.uid ||
        resource.data.targetUserId == request.auth.uid
      );
      allow create: if isAuth();
      allow update: if false;
      allow delete: if false;
    }
  }
}
